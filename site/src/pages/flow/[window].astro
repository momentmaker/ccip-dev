---
import ChainIcons from '../../components/ChainIcons.astro';
import CostPicker from '../../components/CostPicker';
import FlowChord from '../../components/FlowChord';
import ShareButton from '../../components/ShareButton';
import Base from '../../layouts/Base.astro';
import { buildData } from '../../lib/build-data';
import { WINDOWS, type Window } from '../../lib/card-paths';
import { slugMap } from '../../lib/chain-slug';
import { flowData } from '../../lib/flow';
import { formatCount, formatUsd } from '../../lib/format';
import { chainName, chainNameMap } from '../../lib/names';

export function getStaticPaths() {
  return WINDOWS.map((window) => ({ params: { window } }));
}

const LABEL: Record<Window, string> = { '7d': '7 days', '30d': '30 days', all: 'All time' };
const window = Astro.params.window as Window;
const [replay, chains] = await Promise.all([buildData('replay.json'), buildData('chains.json')]);
const names = chainNameMap([...replay.chains, ...chains.chains]);
const data = flowData(replay, window, names);
const slugs = slugMap(replay.chains);
const costChains = replay.chains.map((c) => ({ selector: c.selector, name: chainName(names, c.selector), slug: slugs.get(c.selector) ?? c.selector }));
const scope = window === 'all' ? `since ${replay.since}` : `last ${LABEL[window]}`;
const leader = data.topLanes[0];
---
<Base title={`Flow · ${LABEL[window]}`} description={`Where CCIP value flows between chains, ${scope}.`} cardPath={`flow/${window}`}>
  <div class="page-head">
    <div>
      <p class="label">{scope}</p>
      <h1>Lane flow</h1>
    </div>
    <ShareButton client:load view={`flow/${window}`} headline={leader ? `Biggest CCIP lane, ${scope}: ${leader.label} (${formatUsd(leader.usd)})` : 'CCIP lane flow'} url={`https://ccip.dev/flow/${window}/`} cardUrl={`/og/flow/${window}.png`} />
  </div>
  <CostPicker client:load chains={costChains} />
  <nav class="tabs" aria-label="Window">
    {WINDOWS.map((w) => <a href={`/flow/${w}/`} aria-current={w === window ? 'page' : undefined}>{LABEL[w]}</a>)}
  </nav>
  <section class="card flow-card">
    <FlowChord client:visible data={data} />
    <p class="muted">The 20 chains with the most value in this window; the rest are grouped as Other. Hover or tap a chain to isolate its flows.</p>
  </section>
  <h2>Top lanes</h2>
  <div class="table-wrap card">
    <table class="data">
      <thead><tr><th>Lane</th><th class="num">Messages</th><th class="num">Value</th></tr></thead>
      <tbody>
        {data.topLanes.map((l) => <tr><td><ChainIcons selectors={[l.src, l.dst]} />{l.label}</td><td class="num">{formatCount(l.messages)}</td><td class="num">{formatUsd(l.usd)}</td></tr>)}
      </tbody>
    </table>
  </div>
</Base>

<style>
  .flow-card :global(svg) { display: block; width: 100%; max-width: min(720px, max(320px, calc(100dvh - 360px))); margin: 0 auto; }
  .flow-card :global(.flow-label) { fill: var(--muted); font-size: 12px; }
  .flow-card :global(.tabs button) { padding: 6px 12px; border-radius: 999px; border: 0; background: none; color: var(--muted); font: 600 13px var(--font-sans); cursor: pointer; }
  .flow-card :global(.tabs button.active) { background: #13244d; color: var(--fg); box-shadow: inset 0 0 0 1px var(--blue-2); }
  :global(.cost-picker) { margin: 12px 0 16px; }
  :global(.cost-picker h2) { margin: 0 0 12px; }
  :global(.cost-body) { display: grid; gap: 16px; grid-template-columns: minmax(0, 260px) 1fr; align-items: start; }
  :global(.cost-selects) { display: grid; gap: 10px; }
  :global(.cost-field) { display: grid; gap: 4px; }
  :global(.cost-field select) { width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--card-2); color: var(--fg); font: inherit; font-size: 16px; }
  :global(.cost-picker .small) { font-size: 12px; }
  :global(.cost-result p) { margin: 4px 0; }
  :global(.cost-route) { font-weight: 600; }
  :global(.cost-typical) { font: 700 clamp(32px, 6vw, 44px)/1.1 var(--font-mono); }
  :global(.cost-skeleton) { display: grid; gap: 10px; }
  :global(.cost-skeleton [aria-hidden]) { display: block; height: 18px; border-radius: 6px; background: var(--card-2); }
  :global(.cost-skeleton [aria-hidden]:nth-child(2)) { height: 44px; width: 40%; }
  :global(.cost-skeleton) { min-height: 190px; }
  @media (max-width: 640px) { :global(.cost-body) { grid-template-columns: 1fr; } :global(.cost-skeleton) { min-height: 350px; } }
</style>
