---
import Base from '../layouts/Base.astro';
import { buildData } from '../lib/build-data';
import { formatCount } from '../lib/format';

const today = await buildData('today.json');
---
<Base title="ccip.dev" description="Every Chainlink CCIP message, live: today's totals, history, top lanes, tokens and senders." cardPath="home">
  <h1>{formatCount(today.totals.messages)} CCIP messages today</h1>
</Base>
