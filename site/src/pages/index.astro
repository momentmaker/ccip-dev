---
import HomeLive from '../components/home/HomeLive';
import ReserveTeaser from '../components/home/ReserveTeaser';
import SponsorCard from '../components/SponsorCard.astro';
import Base from '../layouts/Base.astro';
import { buildData } from '../lib/build-data';
import { newestFirst } from '../components/home/Feed';
import { chainNameMap } from '../lib/names';
import { computeRecords } from '../lib/records';
import { buildLayout } from '../sky/layout';
import { skySvg } from '../sky/svg';
import { trailingWeights } from '../sky/weights';
import '../styles/home.css';

const [live, today, history, replay, chains, reserve] = await Promise.all([
  buildData('live.json'),
  buildData('today.json'),
  buildData('history.json'),
  buildData('replay.json'),
  buildData('chains.json'),
  buildData('reserve.json'),
]);
const stars = buildLayout(replay.chains);
const weights = trailingWeights(replay, 30);
const names = chainNameMap([...replay.chains, ...chains.chains]);
const records = computeRecords(history.days);
const fallbackSvg = skySvg({
  width: 1280,
  height: 720,
  stars,
  chainValues: weights.chains,
  lanes: weights.lanes,
  title: 'CCIP chains and lanes over the last 30 days',
});
const next = reserve.pace?.next_expected_deposit ?? null;
---
<Base title="ccip.dev" description="Every Chainlink CCIP message, live: today's totals, history, top lanes, tokens and senders, records and the Chainlink Reserve." cardPath="home">
  <h1 class="visually-hidden">Live Chainlink CCIP stats</h1>
  <HomeLive
    client:load
    stars={stars}
    chainNames={[...names]}
    chainValues={[...weights.chains]}
    lanes={weights.lanes.map(({ src, dst, usd }) => ({ src, dst, usd }))}
    initialFeed={newestFirst(live.messages)}
    liveUpdatedAt={live.updated_at}
    today={today}
    yesterday={history.days.at(-1) ?? null}
    records={records}
  >
    <Fragment set:html={fallbackSvg} />
  </HomeLive>
  <section class="home-below">
    <ReserveTeaser
      client:visible
      link={reserve.latest?.link}
      changePct={reserve.cost_basis?.change_pct ?? null}
      next={next}
      overdue={reserve.pace?.deposit_overdue ?? false}
    />
    <a class="card lift" href="/records/">
      <span class="label">Records</span>
      {records.slice(0, 3).map((r) => (
        <p><strong>{r.title}:</strong> <span class="mono">{r.display}</span> <span class="muted">· {r.day}</span></p>
      ))}
    </a>
    <SponsorCard />
  </section>
</Base>

<style>
  .home-below a { color: var(--fg); }
  .home-below a:hover { text-decoration: none; }
  :global(.tile-value) { font-size: 24px; font-weight: 600; margin: 6px 0 2px; }
</style>
