---
import DepositCountdown from '../components/DepositCountdown';
import InfoLink from '../components/InfoLink';
import ReserveVault from '../components/ReserveVault';
import ShareButton from '../components/ShareButton';
import Base from '../layouts/Base.astro';
import { buildData } from '../lib/build-data';
import { DASH, formatCount, formatLink, formatPct, formatUsd, formatUsdFull, formatUtcDay, formatUtcTime } from '../lib/format';
import { shortAddress } from '../lib/names';
import { depositCoins, vaultFill } from '../lib/reserve-view';

const reserve = await buildData('reserve.json');
const fill = vaultFill(reserve.latest?.link);
const cost = reserve.cost_basis;
const pace = reserve.pace;
const perf = reserve.performance;
const transfers = [...reserve.transfers].reverse();
const price = reserve.link_price_usd;
const tone = (v: number | null) => ((v ?? 0) >= 0 ? 'up' : 'down');
const headline = `The Chainlink Reserve holds ${formatLink(reserve.latest?.link)}${cost?.change_pct != null ? `, ${formatPct(cost.change_pct)} vs its cost basis` : ''}`;
---
<Base title="Chainlink Reserve" description="The Chainlink Reserve's LINK: cost basis vs value now, weekly deposit cadence, pace and every transfer." cardPath="reserve">
  <div class="page-head">
    <div>
      <p class="label">Chainlink Reserve · Ethereum<InfoLink metric="reserve" label="the Reserve figures" /></p>
      <h1>{formatLink(reserve.latest?.link)}</h1>
      <p class="muted">{cost?.value_usd != null ? `≈ ${formatUsd(cost.value_usd)} at $${price?.toFixed(2)} per LINK` : ''}</p>
    </div>
    <ShareButton client:load view="reserve" headline={headline} url="https://ccip.dev/reserve/" cardUrl="/og/reserve.png" />
  </div>

  <section class="reserve-grid">
    {fill && <ReserveVault client:visible link={reserve.latest!.link} target={fill.target} fraction={fill.fraction} coins={depositCoins(reserve.weekly).length} />}
    <div class="card">
      <span class="label">Cost basis vs value now</span>
      {cost ? (
        <dl class="facts">
          <dt>Paid at deposit time</dt><dd class="mono">{formatUsdFull(cost.cost_usd)}</dd>
          <dt>Worth now</dt><dd class="mono">{formatUsdFull(cost.value_usd)}</dd>
          <dt>Change</dt><dd class={`mono ${tone(cost.change_pct)}`}>{formatUsd(cost.change_usd)} ({formatPct(cost.change_pct)})</dd>
          <dt>Average deposit price</dt><dd class="mono">${cost.avg_deposit_price_usd?.toFixed(2) ?? DASH}</dd>
          <dt>LINK now</dt><dd class="mono">${price?.toFixed(2) ?? DASH}</dd>
        </dl>
      ) : (
        <p class="muted">The cost basis appears once the Reserve's transfer history is loaded.</p>
      )}
    </div>
  </section>

  {pace && (
    <section class="tiles reserve-tiles">
      <div class="tile">
        <span class="label">Next deposit</span>
        <p class="value"><DepositCountdown client:load next={pace.next_expected_deposit} overdue={pace.deposit_overdue} /></p>
        <span class="sub">every {pace.avg_days_between_deposits ?? DASH} days on average · streak {formatCount(pace.deposit_streak)}</span>
      </div>
      <div class="tile">
        <span class="label">Last deposit</span>
        <p class="value">{formatLink(pace.last_deposit?.link)}</p>
        <span class="sub">{pace.last_deposit ? `${formatUtcDay(pace.last_deposit.ts)} · ${formatUsd(pace.last_deposit.usd)}` : DASH}</span>
      </div>
      <div class="tile">
        <span class="label">Pace</span>
        <p class="value">{formatLink(pace.avg_weekly_link_4w)}/wk</p>
        <span class="sub">{formatLink(pace.annualized_link)} a year at this pace</span>
      </div>
      <div class="tile">
        <span class="label">Share of supply</span>
        <p class="value">{formatPct(pace.supply_share_pct, 2).replace('+', '')}</p>
        <span class="sub">{pace.next_milestone ? `${formatCount(pace.next_milestone.link)} LINK by ~${pace.next_milestone.eta}` : DASH}</span>
      </div>
    </section>
  )}

  {perf && (perf.best || perf.worst) && (
    <section class="card perf">
      <span class="label">Deposit timing</span>
      <p>
        Best price {perf.best ? `$${perf.best.price_usd.toFixed(2)} on ${formatUtcDay(perf.best.ts)}` : DASH} · worst
        {perf.worst ? ` $${perf.worst.price_usd.toFixed(2)} on ${formatUtcDay(perf.worst.ts)}` : ` ${DASH}`} ·
        {perf.above ?? 0} deposits are worth more now, {perf.below ?? 0} less.
      </p>
    </section>
  )}

  {transfers.length > 0 && (
    <>
      <h2>Transfers</h2>
      <div class="table-wrap card">
        <table class="data">
          <thead><tr><th>Time (UTC)</th><th>Direction</th><th class="num">LINK</th><th class="num">Price then</th><th class="num">USD then</th><th class="num">Value now</th><th class="num">Change</th><th>Tx</th></tr></thead>
          <tbody>
            {transfers.map((t) => (
              <tr>
                <td class="mono">{formatUtcDay(t.ts)} {formatUtcTime(t.ts).replace(' UTC', '')}</td>
                <td>{t.direction === 'in' ? 'In' : 'Out'}</td>
                <td class="num">{formatCount(t.link)}</td>
                <td class="num">{t.price_usd === null ? DASH : `$${t.price_usd.toFixed(2)}`}</td>
                <td class="num">{formatUsd(t.usd)}</td>
                <td class="num">{formatUsd(t.value_now_usd)}</td>
                <td class={`num ${tone(t.change_pct)}`}>{formatPct(t.change_pct)}</td>
                <td><a class="mono" href={`https://etherscan.io/tx/${t.tx}`} rel="noopener">{shortAddress(t.tx)}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>

<style>
  .reserve-grid { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 16px; align-items: center; margin-top: 12px; }
  .reserve-tiles { margin-top: 16px; }
  .perf { margin-top: 16px; }
  :global(.vault) { margin: 0; text-align: center; }
  :global(.vault svg) { width: 100%; max-width: 260px; }
  :global(.vault-shell) { fill: var(--card); stroke: var(--blue); stroke-width: 2; }
  :global(.vault-level) { transition: transform 1.4s var(--ease); }
  :global(.coin) { fill: #c9d6f5; opacity: 0; animation: coin-drop 1.1s var(--ease) both; animation-delay: calc(var(--i) * 80ms); }
  @keyframes coin-drop { from { transform: translateY(-260px); opacity: 0; } 30% { opacity: 1; } 80% { opacity: 1; } to { transform: translateY(0); opacity: 0; } }
  :global(.countdown-overdue) { color: var(--warn); }
  @media (max-width: 640px) { .reserve-grid { grid-template-columns: 1fr; } }
</style>
