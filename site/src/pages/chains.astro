---
import Base from '../layouts/Base.astro';
import { BUILD_DATE, buildData } from '../lib/build-data';
import { formatCount, formatUtcDay } from '../lib/format';
import { chainNameMap } from '../lib/names';
import { chainRows, tokenRows } from '../lib/registry';

const [chains, tokens] = await Promise.all([buildData('chains.json'), buildData('tokens.json')]);
const names = chainNameMap(chains.chains);
const chainList = chainRows(chains.chains, BUILD_DATE);
const tokenList = tokenRows(tokens.tokens, names, BUILD_DATE);
---
<Base title="Chains and tokens" description={`All ${chainList.length} CCIP chains and ${tokenList.length} tokens, with when each was first seen.`}>
  <h1>Chains and tokens</h1>
  <p class="muted">{formatCount(chainList.length)} chains · {formatCount(tokenList.length)} tokens · "new" marks anything first seen in the last 14 days.</p>
  <h2>Chains</h2>
  <div class="table-wrap card">
    <table class="data">
      <thead><tr><th>Chain</th><th>Family</th><th>First seen</th></tr></thead>
      <tbody>
        {chainList.map((c) => (
          <tr><td>{c.name}{c.isNew && <span class="badge">new</span>}</td><td class="muted">{c.family ?? '—'}</td><td class="mono">{c.firstSeen ? formatUtcDay(c.firstSeen) : '—'}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <h2>Tokens</h2>
  <div class="table-wrap card">
    <table class="data">
      <thead><tr><th>Token</th><th>Chain</th><th>First seen</th></tr></thead>
      <tbody>
        {tokenList.map((t) => (
          <tr><td>{t.symbol}{t.isNew && <span class="badge">new</span>}{t.name && <span class="secondary">{t.name}</span>}</td><td>{t.chain}</td><td class="mono">{t.firstSeen ? formatUtcDay(t.firstSeen) : '—'}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<style>
  .badge { margin-left: 8px; padding: 1px 8px; border-radius: 999px; background: var(--blue); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  tbody tr { content-visibility: auto; contain-intrinsic-size: auto 40px; }
</style>
