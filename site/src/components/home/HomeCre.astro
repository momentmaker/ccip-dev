---
import type { DayTotals, TopFile } from '@ccip-dev/core/public';
import { creBand, creBars, creLeaders, creMonthTotals, creStats, creSummary, creTotal, CRE_DAYS } from '../../lib/cre';
import { formatCount } from '../../lib/format';

interface Props {
  days: readonly DayTotals[];
  top: TopFile | null;
  projects: ReadonlySet<string>;
}

const { days, top, projects } = Astro.props;
const band = creBand(days);
const total = creTotal(days);
const leaders = creLeaders(top, projects);
const W = 600;
const H = 200;
const chart = band ? creBars(band.series, { width: W, height: H, gap: 2, monthGap: 40 }) : null;
const stats = creStats(days);
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(2)}%`;
---
{band && (
  <section class="band" id="cre" aria-labelledby="cre-title">
    <div class="band-head">
      <div>
        <p class="eyebrow">CRE</p>
        <h2 id="cre-title">Workflows that send CCIP. <span class="g">{formatCount(total)} messages so far.</span></h2>
        <p class="lead">Chainlink's Runtime Environment runs workflows on Chainlink nodes; these CCIP messages were sent by one. The count is a lower bound.</p>
      </div>
      <a class="more-link" href="/methodology/#cre-sent-messages">How we count →</a>
    </div>
    <div class="cre-grid">
      <figure class="card cre-chart">
        <p class="cre-stats">{stats.line}</p>
        {chart && (
          <div class="cre-plot">
            <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label={creSummary(band.series)}>
              {chart.ticks.map((t) => <line class="cre-grid-line" x1="0" x2={W} y1={t.y} y2={t.y} />)}
              {chart.bars.map((b) => b.path && <path class="cre-bar" d={b.path} />)}
              {chart.bars.map((b) => <rect class="cre-col" x={b.columnX} y="0" width={b.columnWidth} height={H} data-tip={b.tip} />)}
            </svg>
            <div aria-hidden="true">
              {chart.ticks.map((t) => <span class="cre-y" style={`top:${pct(t.y, H)}`}>{t.value}</span>)}
              {chart.months.map((m) => <span class="cre-x" style={`left:${pct(m.x, W)}`}>{m.label}</span>)}
              {chart.peak && <span class={`cre-peak ${chart.peak.anchor}`} style={`left:${pct(chart.peak.x, W)};top:${pct(chart.peak.y, H)}`}>{chart.peak.label}</span>}
              <span class="cre-tip" hidden></span>
            </div>
          </div>
        )}
        <figcaption class="label">CRE-sent CCIP messages per day, last {CRE_DAYS} days</figcaption>
        {band && (
          <table class="visually-hidden">
            <caption>CRE-sent CCIP messages per month, within the last {CRE_DAYS} days</caption>
            <thead><tr><th scope="col">Month</th><th scope="col">Messages</th></tr></thead>
            <tbody>
              {creMonthTotals(band.series).map((m) => <tr><th scope="row">{m.month}</th><td>{formatCount(m.messages)}</td></tr>)}
            </tbody>
          </table>
        )}
      </figure>
      {leaders.length > 0 && (
        <div class="card">
          <p class="label">Top CRE senders, 30 days</p>
          <ol class="cre-leaders">
            {leaders.map((l) => (
              <li>
                {l.slug ? <a href={`/projects/${l.slug}/`}>{l.name}</a> : <span>{l.name}</span>}
                <span class="mono muted">{formatCount(l.messages)}</span>
              </li>
            ))}
          </ol>
          <a class="more-link" href="/top/cre/30d/">All CRE senders →</a>
        </div>
      )}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.cre-plot').forEach((plot) => {
    const tip = plot.querySelector<HTMLElement>('.cre-tip');
    if (!tip) return;
    const hide = () => { tip.hidden = true; };
    plot.addEventListener('pointerover', (e) => {
      const col = e.target instanceof Element ? e.target.closest<SVGElement>('[data-tip]') : null;
      if (!col) return hide();
      const box = plot.getBoundingClientRect();
      const colBox = col.getBoundingClientRect();
      tip.textContent = col.dataset.tip ?? '';
      tip.hidden = false;
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.min(Math.max(colBox.left + colBox.width / 2 - box.left, half), box.width - half)}px`;
    });
    plot.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') hide(); });
    document.addEventListener('pointerdown', (e) => { if (!(e.target instanceof Node) || !plot.contains(e.target)) hide(); });
  });
</script>
