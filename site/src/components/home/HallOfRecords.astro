---
import type { Medal } from '../../lib/briefing';
import { formatCount, formatUsd, formatUtcDay } from '../../lib/format';

interface Props {
  medals: Medal[];
  newest: string | null;
  totals: { messages: number; usd: number; since: string | null; through: string | null };
}

const { medals, newest, totals } = Astro.props;
const hex = (r: number) =>
  Array.from({ length: 6 }, (_, k) => {
    const a = (Math.PI / 3) * k - Math.PI / 2;
    return `${(100 + Math.cos(a) * r).toFixed(1)},${(105 + Math.sin(a) * r).toFixed(1)}`;
  }).join(' ');
---
{medals.length > 0 && (
  <section class="band" id="records" aria-labelledby="records-title">
    <div class="band-head">
      <div>
        <p class="eyebrow">Hall of Records</p>
        <h2 id="records-title">The days to <span class="g">beat</span>.</h2>
      </div>
      <a class="more-link" href="/records/">All records →</a>
    </div>
    <svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="medal-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff1c2" />
          <stop offset="0.5" stop-color="#f5c451" />
          <stop offset="1" stop-color="#8a5e10" />
        </linearGradient>
        <linearGradient id="medal-ice" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#8fb0ff" />
        </linearGradient>
        <linearGradient id="medal-gold-text" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff6cf" />
          <stop offset="1" stop-color="#f5c451" />
        </linearGradient>
      </defs>
    </svg>
    <ul class="medals">
      {medals.map((m) => {
        const top = m.key === newest;
        return (
          <li class={top ? 'medal medal-newest' : 'medal'}>
            <a href={`/day/${m.day}/`} aria-label={`${m.title} record: ${m.value} ${m.sub}, ${formatUtcDay(m.day)}`}>
              <svg viewBox="0 0 200 210" aria-hidden="true">
                {top && <polygon points={hex(98)} class="medal-halo" />}
                <polygon points={hex(84)} class="medal-frame" />
                <polygon points={hex(70)} class="medal-inner" />
                <text x="100" y="114" text-anchor="middle" class="medal-value" font-size={m.value.length > 6 ? 27 : 33}>{m.value}</text>
              </svg>
              {top && <span class="medal-new">Newest</span>}
              <span class="medal-title">{m.title}</span>
              <span class="medal-sub">{m.sub}</span>
              <span class="medal-day">{formatUtcDay(m.day)}</span>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="records-total mono">
      {formatCount(totals.messages)} messages · {formatUsd(totals.usd)} moved{totals.since ? ` from ${formatUtcDay(totals.since)}` : ''}{totals.through ? ` through ${formatUtcDay(totals.through)}` : ''}
    </p>
  </section>
)}
